<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ClientInfoCardRoot" style="flex-grow: 1; background-color: rgb(255, 255, 255); min-height: 75px; max-height: 75px; flex-direction: row; align-items: stretch; justify-content: space-around;">
        <ui:Label text="Client ID: #" name="ClientIDLabel" style="-unity-text-align: middle-left; min-width: 70%; max-width: 70%;"/>
        <ui:Button text="Kick" name="KickButton" enabled="true" style="min-width: 30%; max-width: 30%;"/>
    </ui:VisualElement>
</ui:UXML>
